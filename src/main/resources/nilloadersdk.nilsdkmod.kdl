nilmod {
  name "NilLoaderSDK"
  description "Utilities and helper SDK for NilLoader mod development."
  authors "TamKungZ_"
  version "2.0.0"
}

entrypoints {
  premain "me.tamkungz.nilloadersdk.entrypoint.NilLoaderSDKPremain"
  hijack "me.tamkungz.nilloadersdk.entrypoint.NilLoaderSDKHijack"
}

nilloadersdk {
  // Required mods for this mod to run
  // requires "nilloader"

  // Advisory order hints for SDK-aware tooling/runtime
  // load_before "example_optional_mod"
  // load_after "another_optional_mod"

  // Icon path inside the mod jar/resources
  icon "assets/nilloadersdk/icon.png"

  // Public mod page URL
  modurl "https://modrinth.com/mod/nilloadersdk"

  // Source repository URL
  sourceurl "https://github.com/TamKungZ/NilLoaderSDK"

  // License identifier/name
  license "MIT"

  // Contributors / shared credits
  credits "TamKungZ_" "unascribed"

  // Optional: when false, missing required mods will stop startup
  // safeload false
}

